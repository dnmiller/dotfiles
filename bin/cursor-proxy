#!/usr/bin/env bash
#
# Cursor models in opencode, via cursor-api-proxy (OpenAI-compatible API in
# front of Cursor's `agent` CLI) registered as opencode provider "cursor".
#
#   cursor-proxy login         sign in to Cursor, then sync-models
#   cursor-proxy sync-models   apply-config, then write Cursor's model list
#   cursor-proxy apply-config  merge opencode/base.json (provider, agent modes)
#                              into opencode's config; offline, no sign-in needed
#   cursor-proxy start|stop|restart|status|logs
#
# Auth: `cursor-proxy login`, or CURSOR_API_KEY in the environment of the shell
# that starts the proxy (cursor.com/dashboard -> Integrations).

set -euo pipefail

PORT="${CURSOR_PROXY_PORT:-8765}"
URL="http://127.0.0.1:$PORT"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/cursor-proxy"
LOG="$STATE_DIR/proxy.log"
PIDFILE="$STATE_DIR/proxy.pid"
OC_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"
# The script is symlinked into ~/.local/bin; the template lives in the repo.
REPO_DIR="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"
TEMPLATE="${OPENCODE_BASE_CONFIG:-$REPO_DIR/opencode/base.json}"

info() { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[error]\033[0m %s\n' "$*" >&2; exit 1; }

find_bin() {
  local name
  for name in "$@"; do
    if command -v "$name" >/dev/null 2>&1; then command -v "$name"; return; fi
    if [ -x "$HOME/.local/bin/$name" ]; then echo "$HOME/.local/bin/$name"; return; fi
  done
  return 1
}

healthy() { curl -sf -m 2 "$URL/health" >/dev/null 2>&1; }

# Access token saved by `agent login` (empty if none). The proxy runs the CLI
# with a fake HOME on Linux, so the CLI can't find this itself and the proxy
# would start a browser login; handing the token over avoids that.
saved_token() {
  local f node
  if [ "$(uname)" = Darwin ]; then f="$HOME/.cursor/auth.json"
  else f="${XDG_CONFIG_HOME:-$HOME/.config}/cursor/auth.json"; fi
  [ -r "$f" ] || return 0
  node="$(find_bin node)" || return 0
  "$node" -e 'try { process.stdout.write(JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).accessToken || ""); } catch {}' "$f"
}

start() {
  healthy && return 0
  local bin token=""
  bin="$(find_bin cursor-api-proxy)" || die "cursor-api-proxy not installed (re-run ~/.dotfiles/install.sh)."
  if [ -z "${CURSOR_API_KEY:-}${CURSOR_AUTH_TOKEN:-}" ]; then
    token="$(saved_token)"
    [ -n "$token" ] || warn "No Cursor sign-in found; run: cursor-proxy login (or set CURSOR_API_KEY)."
  fi
  mkdir -p "$STATE_DIR"
  # ACP is what lets the model call opencode's tools; without it replies are text-only.
  # Detached from this shell so it outlives the terminal that started it.
  (
    cd "$HOME"
    export CURSOR_BRIDGE_USE_ACP=true CURSOR_BRIDGE_PORT="$PORT"
    # Explicit, so build/plan modes never get the real workspace (an unset value
    # lets non-ask modes switch to it).
    export CURSOR_BRIDGE_CHAT_ONLY_WORKSPACE=true
    export CURSOR_BRIDGE_TIMEOUT_MS="${CURSOR_BRIDGE_TIMEOUT_MS:-1800000}"
    [ -z "$token" ] || export CURSOR_AUTH_TOKEN="$token"
    if command -v setsid >/dev/null 2>&1; then
      setsid nohup "$bin" >>"$LOG" 2>&1 </dev/null &
    else
      nohup "$bin" >>"$LOG" 2>&1 </dev/null &
    fi
    echo $! >"$PIDFILE"
  )
  local i
  for i in $(seq 1 40); do
    healthy && return 0
    sleep 0.25
  done
  die "cursor-api-proxy did not come up on $URL; see $LOG"
}

stop() {
  local pid
  pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill "$pid" 2>/dev/null; then
    info "Stopped cursor-api-proxy (pid $pid)."
  else
    warn "No cursor-api-proxy started by this script is running."
  fi
  rm -f "$PIDFILE"
}

sync_models() {
  start
  local models node
  node="$(find_bin node)" || die "node not found."
  if ! models="$(curl -sS -m 120 -f "$URL/v1/models" 2>&1)"; then
    die "Could not list Cursor models ($(curl -s -m 120 "$URL/v1/models" | head -c 300)). Signed in? Run: cursor-proxy login"
  fi
  apply_config
  printf '%s' "$models" | "$node" -e '
    const fs = require("fs");
    const path = process.argv[1];
    const ids = JSON.parse(fs.readFileSync(0, "utf8")).data.map((m) => m.id).sort();
    if (!ids.length) { console.error("Cursor returned no models."); process.exit(1); }
    const cfg = JSON.parse(fs.readFileSync(path, "utf8")); // apply_config just wrote/validated it
    cfg.providers.cursor.models = Object.fromEntries(ids.map((id) => [id, {
      name: id,
      capabilities: { tools: true },
      limit: { context: 200000, output: 32000 },
    }]));
    fs.writeFileSync(path, JSON.stringify(cfg, null, 2) + "\n");
    console.error(`Wrote ${ids.length} Cursor models to ${path}`);
  ' "$OC_CONFIG"
  info "Restart opencode (opencode2 service restart), then pick a cursor/... model with /models. Don't use /connect; no API key is needed."
}

# Merge the repo template (opencode/base.json: Cursor provider, build/plan/ask
# agent modes) into opencode's config. The template wins for the keys it
# defines; everything else (MCP servers, plugins, tool edits) is left alone, and
# the live file stays a normal file that other tools can keep editing. Works
# offline and before sign-in; `sync-models` then fills in the model list.
apply_config() {
  local node
  node="$(find_bin node)" || die "node not found."
  [ -r "$TEMPLATE" ] || die "Config template not found: $TEMPLATE"
  mkdir -p "$(dirname "$OC_CONFIG")"
  "$node" -e '
    const fs = require("fs");
    const [path, templatePath, port] = process.argv.slice(1);
    const isObj = (v) => v && typeof v === "object" && !Array.isArray(v);
    const merge = (dst, src) => {
      for (const [k, v] of Object.entries(src)) {
        if (isObj(v) && isObj(dst[k])) merge(dst[k], v);
        else dst[k] = structuredClone(v);
      }
      return dst;
    };
    let cfg = {};
    if (fs.existsSync(path)) {
      try { cfg = JSON.parse(fs.readFileSync(path, "utf8")); }
      catch (e) { console.error(`${path} is not plain JSON (${e.message}); not touching it.`); process.exit(1); }
    }
    const template = JSON.parse(fs.readFileSync(templatePath, "utf8"));
    if (port) template.providers.cursor.settings.baseURL = `http://127.0.0.1:${port}/v1`;
    merge(cfg, template);
    fs.writeFileSync(path, JSON.stringify(cfg, null, 2) + "\n");
  ' "$OC_CONFIG" "$TEMPLATE" "${CURSOR_PROXY_PORT:-}"
  info "Applied $TEMPLATE to $OC_CONFIG"
}

login() {
  local agent
  agent="$(find_bin agent cursor-agent)" || die "Cursor CLI (agent) not installed (re-run ~/.dotfiles/install.sh)."
  # Containers have no browser: print the sign-in URL to open on another machine.
  if [ "$(uname)" != Darwin ] && [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    export NO_OPEN_BROWSER=1
  fi
  "$agent" login
  # Restart so the proxy picks up the new token.
  stop 2>/dev/null || true
  sync_models
}

status() {
  local agent
  if healthy; then info "proxy: up on $URL"; else info "proxy: down"; fi
  if agent="$(find_bin agent cursor-agent)"; then
    "$agent" status 2>&1 | sed 's/^/    /' >&2 || true
  else
    warn "Cursor CLI (agent) not installed."
  fi
  if [ -f "$OC_CONFIG" ] && command -v node >/dev/null 2>&1; then
    node -e '
      const c = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
      const m = Object.keys(c.providers?.cursor?.models ?? {});
      console.error(m.length ? `    opencode: ${m.length} cursor models configured` : "    opencode: no cursor provider (run: cursor-proxy sync-models)");
    ' "$OC_CONFIG" || true
  fi
}

case "${1:-}" in
  start)       start; [ "${2:-}" = "--quiet" ] || info "cursor-api-proxy up on $URL" ;;
  stop)        stop ;;
  restart)     stop; start; info "cursor-api-proxy up on $URL" ;;
  status)      status ;;
  login)       login ;;
  sync-models) sync_models ;;
  apply-config) apply_config ;;
  logs)        exec tail -n "${2:-100}" -f "$LOG" ;;
  *)           sed -n '3,14p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
