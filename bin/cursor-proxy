#!/usr/bin/env bash
#
# Cursor models in opencode, two ways:
#   "cursor"        cursor-opencode-provider plugin (primary). Talks to Cursor's
#                   backend directly; sign in inside opencode: /connect -> Cursor.
#   "cursor-proxy"  cursor-api-proxy (backup): OpenAI-compatible API in front of
#                   Cursor's `agent` CLI. Use it when the provider breaks.
#
#   cursor-proxy provider-status       pinned vs latest cursor-opencode-provider
#   cursor-proxy provider-update [V]   pin version V (default: latest) in
#                                      opencode/base.json, apply it, restart opencode
#   cursor-proxy login         sign in the proxy's Cursor CLI, then sync-models
#   cursor-proxy sync-models   apply-config, then write the proxy's model list
#   cursor-proxy apply-config  merge opencode/base.json (plugin pin, providers,
#                              agents) into opencode's config and link the
#                              cursor-mode plugin; offline, no sign-in needed
#   cursor-proxy start|stop|restart|status|logs
#
# Proxy auth: `cursor-proxy login`, or CURSOR_API_KEY in the environment of the
# shell that starts the proxy (cursor.com/dashboard -> Integrations).

set -euo pipefail

PORT="${CURSOR_PROXY_PORT:-8765}"
URL="http://127.0.0.1:$PORT"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/cursor-proxy"
LOG="$STATE_DIR/proxy.log"
PIDFILE="$STATE_DIR/proxy.pid"
OC_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"
# The script is symlinked into ~/.local/bin; the template lives in the repo.
REPO_DIR="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"
TEMPLATE="${OPENCODE_BASE_CONFIG:-$REPO_DIR/opencode/base.json}"
MODE_PLUGIN="$REPO_DIR/opencode/plugins/cursor-mode"
PROVIDER_PKG="cursor-opencode-provider"
PROXY_ID="cursor-proxy"

info() { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[error]\033[0m %s\n' "$*" >&2; exit 1; }

find_bin() {
  local name
  for name in "$@"; do
    if command -v "$name" >/dev/null 2>&1; then command -v "$name"; return; fi
    if [ -x "$HOME/.local/bin/$name" ]; then echo "$HOME/.local/bin/$name"; return; fi
  done
  return 1
}

healthy() { curl -sf -m 2 "$URL/health" >/dev/null 2>&1; }

# Access token saved by `agent login` (empty if none). The proxy runs the CLI
# with a fake HOME on Linux, so the CLI can't find this itself and the proxy
# would start a browser login; handing the token over avoids that.
saved_token() {
  local f node
  if [ "$(uname)" = Darwin ]; then f="$HOME/.cursor/auth.json"
  else f="${XDG_CONFIG_HOME:-$HOME/.config}/cursor/auth.json"; fi
  [ -r "$f" ] || return 0
  node="$(find_bin node)" || return 0
  "$node" -e 'try { process.stdout.write(JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).accessToken || ""); } catch {}' "$f"
}

start() {
  healthy && return 0
  local bin token=""
  bin="$(find_bin cursor-api-proxy)" || die "cursor-api-proxy not installed (re-run ~/.dotfiles/install.sh)."
  if [ -z "${CURSOR_API_KEY:-}${CURSOR_AUTH_TOKEN:-}" ]; then
    token="$(saved_token)"
    [ -n "$token" ] || warn "No Cursor sign-in found; run: cursor-proxy login (or set CURSOR_API_KEY)."
  fi
  mkdir -p "$STATE_DIR"
  # ACP is what lets the model call opencode's tools; without it replies are text-only.
  # Detached from this shell so it outlives the terminal that started it.
  (
    cd "$HOME"
    export CURSOR_BRIDGE_USE_ACP=true CURSOR_BRIDGE_PORT="$PORT"
    # Explicit, so build/plan modes never get the real workspace (an unset value
    # lets non-ask modes switch to it).
    export CURSOR_BRIDGE_CHAT_ONLY_WORKSPACE=true
    export CURSOR_BRIDGE_TIMEOUT_MS="${CURSOR_BRIDGE_TIMEOUT_MS:-1800000}"
    # The proxy rejects every Cursor built-in tool call (only opencode's tools,
    # bridged over MCP, are allowed). Say so up front, or the model tries its
    # own write/shell first, gets refused, and then reports the fallback.
    # Goes into the bridge preamble line; the proxy caps it at 400 characters.
    export CURSOR_BRIDGE_CONTEXT_EXTRA="${CURSOR_BRIDGE_CONTEXT_EXTRA:-Cursor built-in tools (read, edit, write, shell, grep, etc.) are disabled here and always rejected. Use only the client tools provided over MCP for every file, search and shell action; do not try built-in tools first or mention that they are unavailable.}"
    [ -z "$token" ] || export CURSOR_AUTH_TOKEN="$token"
    if command -v setsid >/dev/null 2>&1; then
      setsid nohup "$bin" >>"$LOG" 2>&1 </dev/null &
    else
      nohup "$bin" >>"$LOG" 2>&1 </dev/null &
    fi
    echo $! >"$PIDFILE"
  )
  local i
  for i in $(seq 1 40); do
    healthy && return 0
    sleep 0.25
  done
  die "cursor-api-proxy did not come up on $URL; see $LOG"
}

stop() {
  local pid
  pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill "$pid" 2>/dev/null; then
    info "Stopped cursor-api-proxy (pid $pid)."
  else
    warn "No cursor-api-proxy started by this script is running."
  fi
  rm -f "$PIDFILE"
}

sync_models() {
  start
  local models node
  node="$(find_bin node)" || die "node not found."
  if ! models="$(curl -sS -m 120 -f "$URL/v1/models" 2>&1)"; then
    die "Could not list Cursor models ($(curl -s -m 120 "$URL/v1/models" | head -c 300)). Signed in? Run: cursor-proxy login"
  fi
  apply_config
  printf '%s' "$models" | "$node" -e '
    const fs = require("fs");
    const [path, id] = process.argv.slice(1);
    const ids = JSON.parse(fs.readFileSync(0, "utf8")).data.map((m) => m.id).sort();
    if (!ids.length) { console.error("Cursor returned no models."); process.exit(1); }
    const cfg = JSON.parse(fs.readFileSync(path, "utf8")); // apply_config just wrote/validated it
    cfg.providers[id].models = Object.fromEntries(ids.map((m) => [m, {
      name: m,
      capabilities: { tools: true },
      limit: { context: 200000, output: 32000 },
    }]));
    fs.writeFileSync(path, JSON.stringify(cfg, null, 2) + "\n");
    console.error(`Wrote ${ids.length} Cursor models to ${path}`);
  ' "$OC_CONFIG" "$PROXY_ID"
  info "Restart opencode (opencode service restart), then pick a $PROXY_ID/... model with /models."
}

# Merge the repo template (opencode/base.json: provider plugin pin, proxy
# provider, build/plan/ask agents) into opencode's config. The template wins for
# the keys it defines; "plugins" entries are merged by package name so other
# plugins stay. Everything else (MCP servers, tool edits) is left alone, and the
# live file stays a normal file that other tools can keep editing. Also links
# the cursor-mode plugin, which maps the active agent to a Cursor mode for proxy
# requests. Works offline and before sign-in.
apply_config() {
  local node plugins_dir
  node="$(find_bin node)" || die "node not found."
  [ -r "$TEMPLATE" ] || die "Config template not found: $TEMPLATE"
  mkdir -p "$(dirname "$OC_CONFIG")"
  # opencode 2 loads every package directory under <config>/plugins/.
  plugins_dir="$(dirname "$OC_CONFIG")/plugins"
  mkdir -p "$plugins_dir"
  if [ -e "$plugins_dir/cursor-mode" ] && [ ! -L "$plugins_dir/cursor-mode" ]; then
    warn "$plugins_dir/cursor-mode exists and is not a symlink; leaving it alone."
  else
    ln -sfn "$MODE_PLUGIN" "$plugins_dir/cursor-mode"
  fi
  "$node" -e '
    const fs = require("fs");
    const [path, templatePath, port, proxyID] = process.argv.slice(1);
    const isObj = (v) => v && typeof v === "object" && !Array.isArray(v);
    const merge = (dst, src) => {
      for (const [k, v] of Object.entries(src)) {
        if (isObj(v) && isObj(dst[k])) merge(dst[k], v);
        else dst[k] = structuredClone(v);
      }
      return dst;
    };
    // "pkg@1.2.3/sub", "@scope/pkg@1/sub", ["pkg", {...}] -> "pkg" / "@scope/pkg"
    const pkgName = (entry) => {
      const s = Array.isArray(entry) ? String(entry[0]) : typeof entry === "string" ? entry : "";
      const m = s.match(/^(@[^/@]+\/[^/@]+|[^/@]+)/);
      return m ? m[1] : s;
    };
    let cfg = {};
    if (fs.existsSync(path)) {
      try { cfg = JSON.parse(fs.readFileSync(path, "utf8")); }
      catch (e) { console.error(`${path} is not plain JSON (${e.message}); not touching it.`); process.exit(1); }
    }
    const template = JSON.parse(fs.readFileSync(templatePath, "utf8"));
    if (port) template.providers[proxyID].settings.baseURL = `http://127.0.0.1:${port}/v1`;

    // Older templates set agents.<name>.request.body.mode, which opencode 2
    // ignores (the cursor-mode plugin sends the mode now); drop the leftovers.
    for (const agent of Object.values(cfg.agents ?? {})) {
      if (!isObj(agent?.request?.body)) continue;
      delete agent.request.body.mode;
      if (!Object.keys(agent.request.body).length) delete agent.request.body;
      if (!Object.keys(agent.request).length) delete agent.request;
    }
    // The proxy used to be provider "cursor"; that id now belongs to
    // cursor-opencode-provider, whose docs warn that a leftover
    // providers.cursor fights its in-memory model list.
    const old = cfg.providers?.cursor;
    if (old?.package?.includes("openai-compatible") && /\/\/127\.0\.0\.1:\d+\/v1/.test(old?.settings?.baseURL ?? "")) {
      delete cfg.providers.cursor;
      console.error("Removed old proxy provider \"cursor\" (now \"" + proxyID + "\"; run cursor-proxy sync-models for its models).");
    }

    // Template plugins replace same-package entries and keep everything else.
    const tplPlugins = template.plugins ?? [];
    delete template.plugins;
    const replaced = new Set(tplPlugins.map(pkgName));
    cfg.plugins = [...(cfg.plugins ?? []).filter((p) => !replaced.has(pkgName(p))), ...tplPlugins];

    merge(cfg, template);
    fs.writeFileSync(path, JSON.stringify(cfg, null, 2) + "\n");
  ' "$OC_CONFIG" "$TEMPLATE" "${CURSOR_PROXY_PORT:-}" "$PROXY_ID"
  info "Applied $TEMPLATE to $OC_CONFIG"
}

# Version of cursor-opencode-provider pinned in the template ("" if none).
pinned_provider() {
  "$(find_bin node)" -e '
    const [path, pkg] = process.argv.slice(1);
    const plugins = JSON.parse(require("fs").readFileSync(path, "utf8")).plugins ?? [];
    for (const p of plugins) {
      const m = String(Array.isArray(p) ? p[0] : p).match(new RegExp("^" + pkg + "@([^/]+)"));
      if (m) { process.stdout.write(m[1]); break; }
    }
  ' "$TEMPLATE" "$PROVIDER_PKG"
}

provider_status() {
  local pinned latest
  pinned="$(pinned_provider)"
  latest="$(npm view "$PROVIDER_PKG" version 2>/dev/null || echo "?")"
  info "$PROVIDER_PKG pinned: ${pinned:-none}  latest on npm: $latest"
  [ "$pinned" = "$latest" ] || info "Update with: cursor-proxy provider-update   (or provider-update <version> to pick one)"
  info "Changelog: https://github.com/oakimov/cursor-opencode-provider/blob/main/CHANGELOG.md"
}

# Pin a cursor-opencode-provider version (default: latest) in the repo template,
# apply it to the live config, and restart opencode so it installs that version.
# Roll back by running it again with the previous version.
provider_update() {
  local want="${1:-}" pinned
  pinned="$(pinned_provider)"
  if [ -z "$want" ] || [ "$want" = latest ]; then
    want="$(npm view "$PROVIDER_PKG" version 2>/dev/null)" || die "Could not reach the npm registry."
  elif [ -z "$(npm view "$PROVIDER_PKG@$want" version 2>/dev/null)" ]; then
    die "$PROVIDER_PKG@$want is not on npm (see: npm view $PROVIDER_PKG versions)."
  fi
  if [ "$want" = "$pinned" ]; then
    info "$PROVIDER_PKG is already pinned at $want."
  else
    "$(find_bin node)" -e '
      const fs = require("fs");
      const [path, pkg, version] = process.argv.slice(1);
      const cfg = JSON.parse(fs.readFileSync(path, "utf8"));
      // Bare "pkg@version": opencode 2 loads the ./server export of the
      // package, which is the opencode2 entry. "pkg@version/plugin/opencode2"
      // breaks: opencode reads "version/plugin/opencode2" as a file path.
      const entry = `${pkg}@${version}`;
      const rest = (cfg.plugins ?? []).filter((p) => !String(Array.isArray(p) ? p[0] : p).startsWith(pkg));
      cfg.plugins = [entry, ...rest];
      fs.writeFileSync(path, JSON.stringify(cfg, null, 2) + "\n");
    ' "$TEMPLATE" "$PROVIDER_PKG" "$want"
    info "Pinned $PROVIDER_PKG ${pinned:-none} -> $want in $TEMPLATE (commit it to keep it)."
  fi
  apply_config
  if command -v opencode >/dev/null 2>&1; then
    opencode service restart >/dev/null 2>&1 && info "Restarted the opencode service." \
      || warn "Could not restart the opencode service; run: opencode service restart"
  fi
  info "If Cursor models break after this, roll back: cursor-proxy provider-update ${pinned:-<version>}"
  info "Meanwhile, $PROXY_ID/... models still work (backup)."
}

login() {
  local agent
  agent="$(find_bin agent cursor-agent)" || die "Cursor CLI (agent) not installed (re-run ~/.dotfiles/install.sh)."
  # Containers have no browser: print the sign-in URL to open on another machine.
  if [ "$(uname)" != Darwin ] && [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    export NO_OPEN_BROWSER=1
  fi
  "$agent" login
  # Restart so the proxy picks up the new token.
  stop 2>/dev/null || true
  sync_models
}

status() {
  local agent
  if healthy; then info "proxy: up on $URL"; else info "proxy: down"; fi
  if agent="$(find_bin agent cursor-agent)"; then
    "$agent" status 2>&1 | sed 's/^/    /' >&2 || true
  else
    warn "Cursor CLI (agent) not installed."
  fi
  if [ -f "$OC_CONFIG" ] && command -v node >/dev/null 2>&1; then
    node -e '
      const [path, id, pkg] = process.argv.slice(1);
      const c = JSON.parse(require("fs").readFileSync(path, "utf8"));
      const m = Object.keys(c.providers?.[id]?.models ?? {});
      console.error(m.length ? `    opencode: ${m.length} ${id} models configured` : `    opencode: no ${id} models (run: cursor-proxy sync-models)`);
      const p = (c.plugins ?? []).map((e) => String(Array.isArray(e) ? e[0] : e)).find((e) => e.startsWith(pkg));
      console.error(p ? `    opencode: provider plugin ${p}` : `    opencode: ${pkg} not enabled (run: cursor-proxy apply-config)`);
    ' "$OC_CONFIG" "$PROXY_ID" "$PROVIDER_PKG" || true
  fi
}

case "${1:-}" in
  start)           start; [ "${2:-}" = "--quiet" ] || info "cursor-api-proxy up on $URL" ;;
  stop)            stop ;;
  restart)         stop; start; info "cursor-api-proxy up on $URL" ;;
  status)          status ;;
  login)           login ;;
  sync-models)     sync_models ;;
  apply-config)    apply_config ;;
  provider-status) provider_status ;;
  provider-update) provider_update "${2:-}" ;;
  logs)            exec tail -n "${2:-100}" -f "$LOG" ;;
  *)               sed -n '3,20p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
