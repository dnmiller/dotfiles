#!/usr/bin/env bash
#
# Cursor models in opencode, via cursor-api-proxy (OpenAI-compatible API in
# front of Cursor's `agent` CLI) registered as opencode provider "cursor".
#
#   cursor-proxy login         sign in to Cursor, then sync-models
#   cursor-proxy sync-models   write Cursor's model list into opencode's config
#   cursor-proxy start|stop|restart|status|logs
#
# Auth: `cursor-proxy login`, or CURSOR_API_KEY in the environment of the shell
# that starts the proxy (cursor.com/dashboard -> Integrations).

set -euo pipefail

PORT="${CURSOR_PROXY_PORT:-8765}"
URL="http://127.0.0.1:$PORT"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/cursor-proxy"
LOG="$STATE_DIR/proxy.log"
PIDFILE="$STATE_DIR/proxy.pid"
OC_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"

info() { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[error]\033[0m %s\n' "$*" >&2; exit 1; }

find_bin() {
  local name
  for name in "$@"; do
    if command -v "$name" >/dev/null 2>&1; then command -v "$name"; return; fi
    if [ -x "$HOME/.local/bin/$name" ]; then echo "$HOME/.local/bin/$name"; return; fi
  done
  return 1
}

healthy() { curl -sf -m 2 "$URL/health" >/dev/null 2>&1; }

start() {
  healthy && return 0
  local bin
  bin="$(find_bin cursor-api-proxy)" || die "cursor-api-proxy not installed (re-run ~/.dotfiles/install.sh)."
  mkdir -p "$STATE_DIR"
  # ACP is what lets the model call opencode's tools; without it replies are text-only.
  # Detached from this shell so it outlives the terminal that started it.
  (
    cd "$HOME"
    export CURSOR_BRIDGE_USE_ACP=true CURSOR_BRIDGE_PORT="$PORT"
    export CURSOR_BRIDGE_TIMEOUT_MS="${CURSOR_BRIDGE_TIMEOUT_MS:-1800000}"
    if command -v setsid >/dev/null 2>&1; then
      setsid nohup "$bin" >>"$LOG" 2>&1 </dev/null &
    else
      nohup "$bin" >>"$LOG" 2>&1 </dev/null &
    fi
    echo $! >"$PIDFILE"
  )
  local i
  for i in $(seq 1 40); do
    healthy && return 0
    sleep 0.25
  done
  die "cursor-api-proxy did not come up on $URL; see $LOG"
}

stop() {
  local pid
  pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill "$pid" 2>/dev/null; then
    info "Stopped cursor-api-proxy (pid $pid)."
  else
    warn "No cursor-api-proxy started by this script is running."
  fi
  rm -f "$PIDFILE"
}

sync_models() {
  start
  local models node
  node="$(find_bin node)" || die "node not found."
  if ! models="$(curl -sS -m 120 -f "$URL/v1/models" 2>&1)"; then
    die "Could not list Cursor models ($(curl -s -m 120 "$URL/v1/models" | head -c 300)). Signed in? Run: cursor-proxy login"
  fi
  mkdir -p "$(dirname "$OC_CONFIG")"
  printf '%s' "$models" | "$node" -e '
    const fs = require("fs");
    const [path, baseURL] = process.argv.slice(1);
    const ids = JSON.parse(fs.readFileSync(0, "utf8")).data.map((m) => m.id).sort();
    if (!ids.length) { console.error("Cursor returned no models."); process.exit(1); }
    let cfg = {};
    if (fs.existsSync(path)) {
      try { cfg = JSON.parse(fs.readFileSync(path, "utf8")); }
      catch (e) { console.error(`${path} is not plain JSON (${e.message}); not touching it.`); process.exit(1); }
    }
    cfg.$schema ??= "https://opencode.ai/config.json";
    cfg.providers ??= {};
    cfg.providers.cursor = {
      name: "Cursor",
      package: "@opencode/ai/providers/openai-compatible",
      settings: { baseURL: `${baseURL}/v1`, apiKey: "unused" },
      models: Object.fromEntries(ids.map((id) => [id, {
        name: id,
        capabilities: { tools: true },
        limit: { context: 200000, output: 32000 },
      }])),
    };
    fs.writeFileSync(path, JSON.stringify(cfg, null, 2) + "\n");
    console.error(`Wrote ${ids.length} Cursor models to ${path}`);
  ' "$OC_CONFIG" "$URL"
  info "Restart opencode to pick them up: opencode2 service restart"
}

login() {
  local agent
  agent="$(find_bin agent cursor-agent)" || die "Cursor CLI (agent) not installed (re-run ~/.dotfiles/install.sh)."
  # Containers have no browser: print the sign-in URL to open on another machine.
  if [ "$(uname)" != Darwin ] && [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    export NO_OPEN_BROWSER=1
  fi
  "$agent" login
  sync_models
}

status() {
  local agent
  if healthy; then info "proxy: up on $URL"; else info "proxy: down"; fi
  if agent="$(find_bin agent cursor-agent)"; then
    "$agent" status 2>&1 | sed 's/^/    /' >&2 || true
  else
    warn "Cursor CLI (agent) not installed."
  fi
  if [ -f "$OC_CONFIG" ] && command -v node >/dev/null 2>&1; then
    node -e '
      const c = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
      const m = Object.keys(c.providers?.cursor?.models ?? {});
      console.error(m.length ? `    opencode: ${m.length} cursor models configured` : "    opencode: no cursor provider (run: cursor-proxy sync-models)");
    ' "$OC_CONFIG" || true
  fi
}

case "${1:-}" in
  start)       start; [ "${2:-}" = "--quiet" ] || info "cursor-api-proxy up on $URL" ;;
  stop)        stop ;;
  restart)     stop; start; info "cursor-api-proxy up on $URL" ;;
  status)      status ;;
  login)       login ;;
  sync-models) sync_models ;;
  logs)        exec tail -n "${2:-100}" -f "$LOG" ;;
  *)           sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
