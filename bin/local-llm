#!/usr/bin/env bash
#
# Qwen3-Coder-Next on llama.cpp's llama-server, for opencode (provider
# "llama-cpp", model "llama-cpp/qwen3-coder-next"). The server runs on the host;
# Docker containers use it through a forwarder on each Docker bridge address.
#
#   local-llm start [--quiet]   start the server in the background (the first
#                               start downloads the model, ~49 GB) and forward
#                               it to Docker networks created since
#   local-llm stop|restart|status|logs
#   local-llm bench             llama-bench the model (server stopped), to
#                               compare quants: LLM_QUANT=UD-Q8_K_XL local-llm bench
#   local-llm apply-config      add the provider to opencode's config (in a
#                               container: pointing at the host's server)
#
# The server unloads the model after LLM_IDLE seconds without requests and
# reloads it on the next one, so it can stay running.
#
# Settings (env): LLM_REPO, LLM_QUANT (UD-Q6_K_XL ~72 GB or UD-Q8_K_XL ~85 GB
# for more quality; generation slows roughly with size), LLM_PORT, LLM_CTX,
# LLM_IDLE; in containers, LLM_HOST (default: the container's gateway).

set -euo pipefail

LLM_REPO="${LLM_REPO:-unsloth/Qwen3-Coder-Next-GGUF}"
LLM_QUANT="${LLM_QUANT:-UD-Q4_K_XL}"
LLM_ALIAS="qwen3-coder-next"
LLM_PORT="${LLM_PORT:-8012}"
LLM_CTX="${LLM_CTX:-262144}"
LLM_IDLE="${LLM_IDLE:-1800}"
PROVIDER_ID="llama-cpp"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/local-llm"
LOG="$STATE_DIR/server.log"
PIDFILE="$STATE_DIR/server.pid"
OC_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"

info() { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[error]\033[0m %s\n' "$*" >&2; exit 1; }

# Same guess as install.sh, including its DOTFILES_ENV override.
in_container() {
  case "${DOTFILES_ENV:-}" in container) return 0 ;; host) return 1 ;; esac
  [ -e /.dockerenv ] || [ -e /run/.containerenv ] \
    || [ -n "${REMOTE_CONTAINERS:-}${CODESPACES:-}${container:-}" ]
}

# The container's default gateway is the host's address on that Docker network.
# Read from /proc because containers often lack `ip`.
gateway() {
  local g
  g="$(awk '$2 == "00000000" { print $3; exit }' /proc/net/route 2>/dev/null)"
  [ -n "$g" ] || die "No default route; set LLM_HOST to the host's address."
  printf '%d.%d.%d.%d\n' "0x${g:6:2}" "0x${g:4:2}" "0x${g:2:2}" "0x${g:0:2}"
}

if in_container; then
  URL="http://${LLM_HOST:-$(gateway)}:$LLM_PORT"
else
  URL="http://127.0.0.1:$LLM_PORT"
fi

host_only() {
  in_container && die "The server runs on the host (local-llm $1 there); this container uses it at $URL."
  return 0
}

tool_bin() {
  command -v "$1" && return
  local f="$HOME/.local/state/dotfiles/tools/bin/$1"
  [ -x "$f" ] && { echo "$f"; return; }
  die "$1 not found (re-run ~/.dotfiles/install.sh)."
}

# Tuned for the DGX Spark (GB10, unified memory), following llama.cpp's Spark
# benchmarks (ggml-org/llama.cpp#16578): all layers on the GPU, flash attention,
# 2048-token micro-batches for prompt processing, and no mmap, which loads
# several times slower on the Spark.
SPARK_ARGS=(-ngl 999 -fa on -b 2048 -ub 2048 --load-mode none)

# Any HTTP answer means a server is listening; /health is 200 only once the
# model is loaded (503 while downloading or loading).
listening() { curl -s -o /dev/null -m 2 "$URL/health"; }
ready() { curl -sf -o /dev/null -m 2 "$URL/health"; }

# Host addresses on Docker bridges (docker0, and br-* for compose networks).
# Only containers can reach these, so the server stays off the LAN.
bridge_addrs() {
  command -v ip >/dev/null 2>&1 || return 0
  ip -4 -o addr show | awk '$2 ~ /^(docker0|br-)/ { sub(/\/.*/, "", $4); print $4 }'
}

forwarder_pids() { cat "$STATE_DIR"/forward-*.pid 2>/dev/null || true; }

# One socat per bridge address, relaying to the server on 127.0.0.1; skips
# addresses that already have one.
forward() {
  local quiet="$1" socat addr pidfile
  [ -n "$(bridge_addrs)" ] || return 0
  if ! socat="$(command -v socat || ls "$HOME/.local/state/dotfiles/tools/bin/socat" 2>/dev/null)"; then
    warn "socat not found, so containers can't reach the server (re-run ~/.dotfiles/install.sh)."
    return 0
  fi
  for addr in $(bridge_addrs); do
    pidfile="$STATE_DIR/forward-$addr.pid"
    kill -0 "$(cat "$pidfile" 2>/dev/null)" 2>/dev/null && continue
    setsid nohup "$socat" "TCP-LISTEN:$LLM_PORT,bind=$addr,fork,reuseaddr" \
      "TCP:127.0.0.1:$LLM_PORT" >>"$LOG" 2>&1 </dev/null &
    echo $! >"$pidfile"
    [ -n "$quiet" ] || info "Forwarding $addr:$LLM_PORT to the server for containers."
  done
}

start() {
  local quiet="${1:-}" bin i
  host_only start
  mkdir -p "$STATE_DIR"
  forward "$quiet"
  if listening; then
    [ -n "$quiet" ] || info "llama-server already running on $URL"
    return 0
  fi
  bin="$(tool_bin llama-server)"
  (
    cd "$HOME"
    # Sampling from the model card: temperature 1.0, top_p 0.95, top_k 40.
    set -- "$bin" -hf "$LLM_REPO:$LLM_QUANT" --alias "$LLM_ALIAS" \
      --host 127.0.0.1 --port "$LLM_PORT" -c "$LLM_CTX" "${SPARK_ARGS[@]}" --jinja \
      --temp 1.0 --top-p 0.95 --top-k 40 --sleep-idle-seconds "$LLM_IDLE"
    if command -v setsid >/dev/null 2>&1; then
      setsid nohup "$@" >>"$LOG" 2>&1 </dev/null &
    else
      nohup "$@" >>"$LOG" 2>&1 </dev/null &
    fi
    echo $! >"$PIDFILE"
  )
  for i in $(seq 1 20); do
    listening && break
    kill -0 "$(cat "$PIDFILE")" 2>/dev/null || die "llama-server exited; see $LOG"
    sleep 0.5
  done
  [ -n "$quiet" ] && return 0
  if ready; then
    info "llama-server ready on $URL"
  else
    info "llama-server starting on $URL (downloading or loading the model; follow with: local-llm logs)"
  fi
}

stop() {
  local pid
  host_only stop
  # shellcheck disable=SC2046
  kill $(forwarder_pids) 2>/dev/null || true
  rm -f "$STATE_DIR"/forward-*.pid
  pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill "$pid" 2>/dev/null; then
    info "Stopped llama-server (pid $pid)."
  else
    warn "No llama-server started by this script is running."
  fi
  rm -f "$PIDFILE"
}

# Exits 1 when the server is down.
status() {
  local f
  if curl -s -m 2 "$URL/props" | grep -q '"is_sleeping":true'; then
    info "llama-server: sleeping on $URL (model unloaded while idle; the next request reloads it)"
  elif ready; then info "llama-server: ready on $URL"
  elif listening; then info "llama-server: up on $URL, still downloading or loading the model"
  elif in_container; then info "llama-server: not reachable at $URL (start it on the host: local-llm start)"; return 1
  else info "llama-server: down (start with: local-llm start)"; return 1
  fi
  in_container && return 0
  for f in "$STATE_DIR"/forward-*.pid; do
    [ -e "$f" ] && kill -0 "$(cat "$f")" 2>/dev/null || continue
    f="${f##*/forward-}"
    info "Forwarding for containers: ${f%.pid}:$LLM_PORT"
  done
}

# Same settings as the server; prompt processing (pp) and generation (tg) speed
# at growing context depths (d).
bench() {
  host_only bench
  listening && die "Stop the server first (local-llm stop): two copies may not fit in memory."
  "$(tool_bin llama-bench)" -hf "$LLM_REPO:$LLM_QUANT" "${SPARK_ARGS[@]}" \
    -d 0,8192,32768 -p 2048 -n 32
}

apply_config() {
  command -v node >/dev/null 2>&1 || die "node not found."
  mkdir -p "$(dirname "$OC_CONFIG")"
  node -e '
    const fs = require("fs");
    const [path, id, url, alias, ctx] = process.argv.slice(1);
    let cfg = {};
    if (fs.existsSync(path)) {
      try { cfg = JSON.parse(fs.readFileSync(path, "utf8")); }
      catch (e) { console.error(`${path} is not plain JSON (${e.message}); not touching it.`); process.exit(1); }
    }
    cfg.providers ??= {};
    cfg.providers[id] = {
      name: "llama.cpp (local)",
      package: "@opencode/ai/providers/openai-compatible",
      settings: { baseURL: `${url}/v1`, apiKey: "unused" },
      models: {
        [alias]: {
          name: "Qwen3 Coder Next (local)",
          capabilities: { tools: true },
          limit: { context: Number(ctx), output: 65536 },
        },
      },
    };
    fs.writeFileSync(path, JSON.stringify(cfg, null, 2) + "\n");
  ' "$OC_CONFIG" "$PROVIDER_ID" "$URL" "$LLM_ALIAS" "$LLM_CTX"
  info "Added provider $PROVIDER_ID ($PROVIDER_ID/$LLM_ALIAS, $URL) to $OC_CONFIG"
}

case "${1:-}" in
  start)        start "${2:-}" ;;
  stop)         stop ;;
  restart)      stop; start ;;
  status)       status ;;
  logs)         host_only logs; exec tail -n "${2:-100}" -f "$LOG" ;;
  bench)        bench ;;
  apply-config) apply_config ;;
  *)            sed -n '3,21p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
