#!/usr/bin/env bash
#
# Qwen3-Coder-Next on llama.cpp's llama-server, for opencode (provider
# "llama-cpp", model "llama-cpp/qwen3-coder-next"). Hosts only: install.sh
# sets this up where there is memory for it.
#
#   local-llm start [--quiet]   start the server in the background; the first
#                               start downloads the model (~49 GB)
#   local-llm stop|restart|status|logs
#   local-llm bench             llama-bench the model (server stopped), to
#                               compare quants: LLM_QUANT=UD-Q8_K_XL local-llm bench
#   local-llm apply-config      add the provider to opencode's config
#
# The server unloads the model after LLM_IDLE seconds without requests and
# reloads it on the next one, so it can stay running.
#
# Settings (env): LLM_REPO, LLM_QUANT (UD-Q6_K_XL ~72 GB or UD-Q8_K_XL ~85 GB
# for more quality; generation slows roughly with size), LLM_PORT, LLM_CTX,
# LLM_IDLE.

set -euo pipefail

LLM_REPO="${LLM_REPO:-unsloth/Qwen3-Coder-Next-GGUF}"
LLM_QUANT="${LLM_QUANT:-UD-Q4_K_XL}"
LLM_ALIAS="qwen3-coder-next"
LLM_PORT="${LLM_PORT:-8012}"
LLM_CTX="${LLM_CTX:-262144}"
LLM_IDLE="${LLM_IDLE:-1800}"
PROVIDER_ID="llama-cpp"

URL="http://127.0.0.1:$LLM_PORT"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/local-llm"
LOG="$STATE_DIR/server.log"
PIDFILE="$STATE_DIR/server.pid"
OC_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"

info() { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[error]\033[0m %s\n' "$*" >&2; exit 1; }

llama_bin() {
  command -v "$1" && return
  local f="$HOME/.local/state/dotfiles/tools/bin/$1"
  [ -x "$f" ] && { echo "$f"; return; }
  die "$1 not found (re-run ~/.dotfiles/install.sh on a host)."
}

# Tuned for the DGX Spark (GB10, unified memory), following llama.cpp's Spark
# benchmarks (ggml-org/llama.cpp#16578): all layers on the GPU, flash attention,
# 2048-token micro-batches for prompt processing, and no mmap, which loads
# several times slower on the Spark.
SPARK_ARGS=(-ngl 999 -fa on -b 2048 -ub 2048 --load-mode none)

# Any HTTP answer means a server is listening; /health is 200 only once the
# model is loaded (503 while downloading or loading).
listening() { curl -s -o /dev/null -m 2 "$URL/health"; }
ready() { curl -sf -o /dev/null -m 2 "$URL/health"; }

start() {
  local quiet="${1:-}" bin i
  if listening; then
    [ -n "$quiet" ] || info "llama-server already running on $URL"
    return 0
  fi
  bin="$(llama_bin llama-server)"
  mkdir -p "$STATE_DIR"
  (
    cd "$HOME"
    # Sampling from the model card: temperature 1.0, top_p 0.95, top_k 40.
    set -- "$bin" -hf "$LLM_REPO:$LLM_QUANT" --alias "$LLM_ALIAS" \
      --host 127.0.0.1 --port "$LLM_PORT" -c "$LLM_CTX" "${SPARK_ARGS[@]}" --jinja \
      --temp 1.0 --top-p 0.95 --top-k 40 --sleep-idle-seconds "$LLM_IDLE"
    if command -v setsid >/dev/null 2>&1; then
      setsid nohup "$@" >>"$LOG" 2>&1 </dev/null &
    else
      nohup "$@" >>"$LOG" 2>&1 </dev/null &
    fi
    echo $! >"$PIDFILE"
  )
  for i in $(seq 1 20); do
    listening && break
    kill -0 "$(cat "$PIDFILE")" 2>/dev/null || die "llama-server exited; see $LOG"
    sleep 0.5
  done
  [ -n "$quiet" ] && return 0
  if ready; then
    info "llama-server ready on $URL"
  else
    info "llama-server starting on $URL (downloading or loading the model; follow with: local-llm logs)"
  fi
}

stop() {
  local pid
  pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill "$pid" 2>/dev/null; then
    info "Stopped llama-server (pid $pid)."
  else
    warn "No llama-server started by this script is running."
  fi
  rm -f "$PIDFILE"
}

status() {
  if ready; then info "llama-server: ready on $URL ($LLM_REPO:$LLM_QUANT)"
  elif listening; then info "llama-server: up on $URL, still downloading or loading the model"
  else info "llama-server: down (start with: local-llm start)"
  fi
}

# Same settings as the server; prompt processing (pp) and generation (tg) speed
# at growing context depths (d).
bench() {
  listening && die "Stop the server first (local-llm stop): two copies may not fit in memory."
  "$(llama_bin llama-bench)" -hf "$LLM_REPO:$LLM_QUANT" "${SPARK_ARGS[@]}" \
    -d 0,8192,32768 -p 2048 -n 32
}

apply_config() {
  command -v node >/dev/null 2>&1 || die "node not found."
  mkdir -p "$(dirname "$OC_CONFIG")"
  node -e '
    const fs = require("fs");
    const [path, id, port, alias, ctx] = process.argv.slice(1);
    let cfg = {};
    if (fs.existsSync(path)) {
      try { cfg = JSON.parse(fs.readFileSync(path, "utf8")); }
      catch (e) { console.error(`${path} is not plain JSON (${e.message}); not touching it.`); process.exit(1); }
    }
    cfg.providers ??= {};
    cfg.providers[id] = {
      name: "llama.cpp (local)",
      package: "@opencode/ai/providers/openai-compatible",
      settings: { baseURL: `http://127.0.0.1:${port}/v1`, apiKey: "unused" },
      models: {
        [alias]: {
          name: "Qwen3 Coder Next (local)",
          capabilities: { tools: true },
          limit: { context: Number(ctx), output: 65536 },
        },
      },
    };
    fs.writeFileSync(path, JSON.stringify(cfg, null, 2) + "\n");
  ' "$OC_CONFIG" "$PROVIDER_ID" "$LLM_PORT" "$LLM_ALIAS" "$LLM_CTX"
  info "Added provider $PROVIDER_ID ($PROVIDER_ID/$LLM_ALIAS) to $OC_CONFIG"
}

case "${1:-}" in
  start)        start "${2:-}" ;;
  stop)         stop ;;
  restart)      stop; start ;;
  status)       status ;;
  logs)         exec tail -n "${2:-100}" -f "$LOG" ;;
  bench)        bench ;;
  apply-config) apply_config ;;
  *)            sed -n '3,19p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
