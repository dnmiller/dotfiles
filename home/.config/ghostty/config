# Cmd+h/j/k/l -> tmux pane focus (see user-keys in ~/.tmux.conf).
keybind = cmd+h=text:\x1b[9001~
keybind = cmd+j=text:\x1b[9002~
keybind = cmd+k=text:\x1b[9003~
keybind = cmd+l=text:\x1b[9004~

# Cmd+C -> Esc y (<M-y>), which Neovim maps to "copy visual selection to the
# system clipboard" (see lua/config/keymaps.lua). Neovim captures the mouse, so
# Ghostty has no selection of its own to copy. Tmux-copy-mode and mouse
# selections already reach the clipboard on release (set-clipboard on).
keybind = cmd+c=text:\x1by
