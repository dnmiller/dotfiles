{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["cursor-opencode-provider@0.8.1", "@dietrichgebert/ponytail@5.3.2"],
  "instructions": ["cursor-tools.md", "explore.md"],
  "mcp": {
    "servers": {
      "linear": { "type": "remote", "url": "https://mcp.linear.app/mcp", "codemode": false },
      "context7": { "type": "remote", "url": "https://mcp.context7.com/mcp", "codemode": false }
    }
  },
  "agents": {
    "build": {
      "description": "Cursor agent mode: makes changes and runs tools to get the task done"
    },
    "plan": {
      "description": "Cursor plan mode: researches and proposes a plan, no changes until you approve"
    },
    "ask": {
      "mode": "primary",
      "description": "Answers questions about the code: no edits, shell commands need approval",
          "permissions": [
            { "action": "edit", "resource": "*", "effect": "deny" },
            { "action": "shell", "resource": "*", "effect": "ask" }
          ]
        },
        "local-build": {
          "mode": "primary",
          "model": "llama-cpp/qwen3-coder-next",
          "description": "Build on the local model, without Linear",
          "permissions": [{ "action": "linear_*", "resource": "*", "effect": "deny" }]
        },
        "local-plan": {
          "mode": "primary",
          "model": "llama-cpp/qwen3-coder-next",
          "description": "Plan on the local model, without Linear: no edits",
          "permissions": [
            { "action": "edit", "resource": "*", "effect": "deny" },
            { "action": "linear_*", "resource": "*", "effect": "deny" }
          ]
        },
        "local-ask": {
          "mode": "primary",
          "model": "llama-cpp/qwen3-coder-next",
          "description": "Ask on the local model, without Linear: no edits, shell commands need approval",
          "permissions": [
            { "action": "edit", "resource": "*", "effect": "deny" },
            { "action": "shell", "resource": "*", "effect": "ask" },
            { "action": "linear_*", "resource": "*", "effect": "deny" }
          ]
        }
      }
}
